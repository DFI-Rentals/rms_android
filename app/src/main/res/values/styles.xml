<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RmsSegment">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/rms_text_secondary</item>
        <item name="android:background">@drawable/bg_segment_inactive</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <!-- Follows the system light/dark setting, like the RMS web app -->
    <style name="Theme.Rms" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/rms_surface</item>
        <item name="android:statusBarColor">@color/rms_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
