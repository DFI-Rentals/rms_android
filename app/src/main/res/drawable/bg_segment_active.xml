<?xml version="1.0" encoding="utf-8"?>
<!-- Active segment: white, rounded-md, shadow-sm -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp" android:left="0dp" android:right="0dp" android:bottom="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rms_segment_shadow" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rms_segment_active" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
