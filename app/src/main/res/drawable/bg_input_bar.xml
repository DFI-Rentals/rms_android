    <item>
        <shape android:shape="rectangle"><solid android:color="@color/rms_border" /></shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle"><solid android:color="@color/rms_surface" /></shape>
    </item>
</layer-list>
