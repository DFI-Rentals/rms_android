<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignParentTop="true"
        android:max="100"
        android:progressTint="@color/rms_text_primary"
        android:progressBackgroundTint="@color/rms_border"
        android:visibility="gone" />

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/progressBar"
        android:layout_above="@id/toggleBar" />

    <LinearLayout
        android:id="@+id/toggleBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_input_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="12dp"
        android:paddingTop="1dp">

        <!-- Status: dot + label, mirrors the RMS "Ready to scan" indicator -->
        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/status_dot_off" />

        <TextView
            android:id="@+id/currentModeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Keyboard"
            android:textColor="@color/rms_text_primary"
            android:textSize="13sp" />

        <!-- Segmented control: Auto / Keyboard / Scanner (badge-modal Scanner|Camera pattern) -->
        <LinearLayout
            android:id="@+id/modeGroup"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/modeAuto"
                style="@style/RmsSegment"
                android:text="Auto" />

            <TextView
                android:id="@+id/modeKeyboard"
                style="@style/RmsSegment"
                android:text="Keyboard" />

            <TextView
                android:id="@+id/modeScanner"
                style="@style/RmsSegment"
                android:text="Scanner" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
